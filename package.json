{
  "name": "metachat",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "HTMX server-rendered chat with React islands",
  "scripts": {
    "dev": "concurrently -k \"node --watch server.js\" \"vite --config vite.islands.config.js --watch\"",
    "start": "node server.js",
    "build": "vite build --config vite.islands.config.js",
    "test": "node --test"
  },
  "dependencies": {
    "express": "^4.21.2",
    "htmx.org": "^2.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "vite": "^6.0.7"
  }
}
